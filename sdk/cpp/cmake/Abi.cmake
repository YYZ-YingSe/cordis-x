include(${CMAKE_CURRENT_LIST_DIR}/Package.cmake)
foreach(generation v1 v2)
  add_library(cordis_package_leaf_${generation} SHARED tests/package/helper.cpp)
  target_compile_definitions(cordis_package_leaf_${generation} PRIVATE
    CORDIS_BUILD_HELPER=1 CORDIS_HELPER_SYMBOL=cordis_package_leaf_${generation}
    CORDIS_HELPER_VERSION="${generation}")
  set_target_properties(cordis_package_leaf_${generation} PROPERTIES CXX_VISIBILITY_PRESET hidden)
  add_library(cordis_package_helper_${generation} SHARED tests/package/helper.cpp)
  target_compile_definitions(cordis_package_helper_${generation} PRIVATE
    CORDIS_BUILD_HELPER=1 CORDIS_HELPER_SYMBOL=cordis_helper_${generation}
    CORDIS_HELPER_VERSION="${generation}")
  target_compile_definitions(cordis_package_helper_${generation} PRIVATE CORDIS_HELPER_CHILD=cordis_package_leaf_${generation})
  target_link_libraries(cordis_package_helper_${generation} PRIVATE cordis_package_leaf_${generation})
  set_target_properties(cordis_package_helper_${generation} PROPERTIES CXX_VISIBILITY_PRESET hidden)
  add_library(cordis_package_abi_${generation} SHARED examples/abi/calculator.cpp)
  target_link_libraries(cordis_package_abi_${generation} PRIVATE cordis::abi)
  target_compile_definitions(cordis_package_abi_${generation} PRIVATE
    CORDIS_PACKAGE_HELPER=1 CORDIS_HELPER_SYMBOL=cordis_helper_${generation})
  cordis_package(cordis_package_abi_${generation} GENERATION ${generation}
    PRIVATE_LIBRARIES cordis_package_helper_${generation} cordis_package_leaf_${generation})
endforeach()
