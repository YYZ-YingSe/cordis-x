foreach(kind calculator fixture context managed)
  if(kind STREQUAL "calculator")
    set(versioned_source examples/abi/calculator.cpp)
  elseif(kind STREQUAL "fixture")
    set(versioned_source tests/abi/fixture.cpp)
  elseif(kind STREQUAL "context")
    set(versioned_source tests/abi/context.cpp)
  else()
    set(versioned_source tests/abi/managed.cpp)
  endif()
  add_library(cordis_abi_${kind}_v2 SHARED ${versioned_source})
  target_link_libraries(cordis_abi_${kind}_v2 PRIVATE cordis_abi)
  target_compile_definitions(cordis_abi_${kind}_v2 PRIVATE CORDIS_ABI_CODE_VERSION="v2")
  set_target_properties(cordis_abi_${kind}_v2 PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
  if(MSVC)
    target_compile_options(cordis_abi_${kind}_v2 PRIVATE /W4 /WX)
  else()
    target_compile_options(cordis_abi_${kind}_v2 PRIVATE -Wall -Wextra -Wpedantic -Werror)
  endif()
endforeach()
