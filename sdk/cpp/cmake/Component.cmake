# Build only Cordis and consumer code. Compilers and target dependencies are external.
function(cordis_add_component target)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "WASI")
    message(FATAL_ERROR "cordis_add_component requires an external WASI toolchain and WASI-built dependencies")
  endif()
  cmake_parse_arguments(COMP "CORE" "OUTPUT;PROTOC;WIT_BINDGEN;PACK" "SOURCES;PROTOS;PROTO_PATHS" ${ARGN})
  if(NOT COMP_OUTPUT OR NOT COMP_SOURCES OR NOT COMP_WIT_BINDGEN)
    message(FATAL_ERROR "cordis_add_component requires OUTPUT, SOURCES and WIT_BINDGEN")
  endif()
  if(NOT COMP_CORE AND NOT COMP_PACK)
    message(FATAL_ERROR "Provide the cordis-component-pack executable through PACK")
  endif()
  get_target_property(protocols cordis::core CORDIS_PROTOCOL_DIR)
  get_target_property(runtime cordis::core CORDIS_COMPONENT_SOURCE_DIR)
  set(bindings "${CMAKE_CURRENT_BINARY_DIR}/${target}-bindings")
  file(MAKE_DIRECTORY "${bindings}")
  file(GLOB_RECURSE wit_inputs CONFIGURE_DEPENDS "${protocols}/component/wit/*.wit")
  add_custom_command(
    OUTPUT "${bindings}/managed_plugin.c" "${bindings}/managed_plugin.h" "${bindings}/managed_plugin_component_type.o"
    COMMAND "${COMP_WIT_BINDGEN}" c "${protocols}/component/wit" --world managed-plugin --out-dir "${bindings}"
    DEPENDS ${wit_inputs} VERBATIM)
  set(proto_flags)
  foreach(path IN LISTS COMP_PROTO_PATHS)
    list(APPEND proto_flags "-I${path}")
  endforeach()
  list(APPEND proto_flags "-I${protocols}/protobuf")
  set(proto_sources)
  foreach(proto IN LISTS COMP_PROTOS)
    if(NOT COMP_PROTOC)
      message(FATAL_ERROR "Provide a host protoc executable through PROTOC")
    endif()
    set(relative "")
    foreach(path IN LISTS COMP_PROTO_PATHS)
      file(RELATIVE_PATH candidate "${path}" "${proto}")
      if(NOT candidate MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${candidate}")
        set(relative "${candidate}")
        break()
      endif()
    endforeach()
    if(NOT relative)
      message(FATAL_ERROR "Proto ${proto} must be inside an explicit PROTO_PATHS directory")
    endif()
    string(REGEX REPLACE "\\.proto$" ".pb.cc" generated "${relative}")
    string(REGEX REPLACE "\\.proto$" ".pb.h" header "${relative}")
    add_custom_command(OUTPUT "${bindings}/${generated}" "${bindings}/${header}"
      COMMAND "${COMP_PROTOC}" ${proto_flags} "--cpp_out=${bindings}" "--dependency_out=${bindings}/${generated}.d" "${proto}"
      DEPENDS "${proto}" DEPFILE "${bindings}/${generated}.d" VERBATIM)
    list(APPEND proto_sources "${bindings}/${generated}")
  endforeach()
  add_executable(${target} ${COMP_SOURCES} "${runtime}/runtime.cpp" ${proto_sources}
    "${bindings}/managed_plugin.c" "${bindings}/managed_plugin_component_type.o")
  target_include_directories(${target} PRIVATE "${bindings}")
  target_compile_features(${target} PRIVATE cxx_std_20)
  target_compile_options(${target} PRIVATE -fwasm-exceptions -mllvm -wasm-use-legacy-eh=false)
  target_compile_definitions(${target} PRIVATE _WASI_EMULATED_SIGNAL _WASI_EMULATED_MMAN)
  target_link_options(${target} PRIVATE -fwasm-exceptions -mexec-model=reactor)
  target_link_libraries(${target} PRIVATE cordis::core wasi-emulated-signal wasi-emulated-mman unwind)
  if(COMP_CORE)
    get_filename_component(directory "${COMP_OUTPUT}" DIRECTORY)
    get_filename_component(name "${COMP_OUTPUT}" NAME_WE)
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${directory}" OUTPUT_NAME "${name}" SUFFIX ".wasm")
  else()
    add_custom_command(OUTPUT "${COMP_OUTPUT}"
      COMMAND "${COMP_PACK}" "$<TARGET_FILE:${target}>" "${COMP_OUTPUT}" --wasi-preview1
      DEPENDS ${target} VERBATIM)
    add_custom_target(${target}_component ALL DEPENDS "${COMP_OUTPUT}")
  endif()
endfunction()
