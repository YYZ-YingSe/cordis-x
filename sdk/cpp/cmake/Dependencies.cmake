if(NOT TARGET absl::base)
  find_package(absl 20260817 EXACT CONFIG REQUIRED)
endif()
if(NOT TARGET protobuf::libprotobuf)
  find_package(Protobuf 34.1.0 EXACT CONFIG REQUIRED)
endif()
get_target_property(_cordis_protobuf_type protobuf::libprotobuf TYPE)
if(NOT _cordis_protobuf_type STREQUAL "STATIC_LIBRARY")
  message(FATAL_ERROR "Cordis requires a private static Protobuf runtime. Provide a matching dependency prefix through CMAKE_PREFIX_PATH or Protobuf_DIR; see the C++ SDK dependency documentation.")
endif()
if(APPLE OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(NOT TARGET absl::abseil_dll)
    message(FATAL_ERROR "Cordis ABI unloading requires host-shared Abseil. Provide its CMake package; the shared runtime must outlive plugin generations (ELF NODELETE on Linux).")
  endif()
endif()
if(APPLE)
  include(CheckCXXSourceCompiles)
  include(CMakePushCheckState)
  cmake_push_check_state(RESET)
  set(CMAKE_REQUIRED_LIBRARIES protobuf::libprotobuf)
  check_cxx_source_compiles("#include <google/protobuf/cordis_thread_storage.h>\nint main() { google::protobuf::internal::CordisShutdownThreadStorage(); }" CORDIS_PROTOBUF_UNLOAD_SUPPORT)
  cmake_pop_check_state()
  if(NOT CORDIS_PROTOBUF_UNLOAD_SUPPORT)
    message(FATAL_ERROR "The supplied Protobuf lacks Cordis macOS thread-storage cleanup support. Integrate the documented adaptation in your dependency build, or explicitly run tools/setup/cpp.py. SDK builds do not install or patch dependencies.")
  endif()
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "WASI")
  find_package(Threads REQUIRED)
endif()
